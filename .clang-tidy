# clang-tidy configuration for egl-util-cpp.
# Enterprise check set from the toolchain profile (bugprone, cert, cppcoreguidelines,
# modernize, performance, portability, readability). A small set of checks is disabled
# because they conflict with legitimate idioms: version macros (preprocessor-checkable by
# design), the doctest test-registration globals, and stylistic noise. CI runs clang-tidy
# with --warnings-as-errors='*', so every enabled diagnostic is a hard failure.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -modernize-macro-to-enum,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-redundant-typename,
  -readability-math-missing-parentheses,
  -readability-uppercase-literal-suffix,
  -bugprone-easily-swappable-parameters,
  -cert-err58-cpp
WarningsAsErrors: '*'
HeaderFilterRegex: 'it/d4np/util/'
FormatStyle: file
CheckOptions:
  # doctest's assertion macros (e.g. CHECK_THROWS_AS) expand to their own internal
  # `remove_reference<...>::type` trait, which modernize-type-traits matches and then blames on
  # the macro-use line in our tests. Skip trait matches that originate inside a macro expansion;
  # the check still applies to our own hand-written code.
  - key: modernize-type-traits.IgnoreMacros
    value: "true"
